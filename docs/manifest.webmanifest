{
  "name": "拾页 · 网页资料库",
  "short_name": "拾页",
  "description": "把散落的网页与讲义，拾进一本随身的册子。HTML/Markdown 渲染、文件夹整理、网页收藏。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f4ec",
  "theme_color": "#f7f4ec",
  "lang": "zh-CN",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["image/*", "text/*", "application/octet-stream", ".html", ".htm", ".md", ".markdown", ".txt"] }
      ],
      "text": "text",
      "url": "url"
    }
  }
}
